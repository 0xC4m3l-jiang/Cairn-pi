{
  "name": "cairn-pi",
  "version": "0.1.0",
  "description": "Blackboard state machine + native subagents: decompose a requirement into independently verifiable nodes, implement each in an isolated context, then integrate and verify.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "blackboard",
    "plan-and-execute",
    "subagent",
    "workflow",
    "state-machine"
  ],
  "files": [
    "extensions",
    "lib",
    "skills",
    "docs",
    "demo",
    "README.md",
    "DESIGN.md",
    "DEVELOPMENT.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/cairn.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run test:demo",
    "test:demo": "node --test demo/*.test.mjs"
  }
}
